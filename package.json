{
  "name": "knucklebones",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @knucklebones/web",
    "build:web": "npm run build -w @knucklebones/web",
    "preview:web": "npm run preview -w @knucklebones/web",
    "dev:mobile": "npm run start -w @knucklebones/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
